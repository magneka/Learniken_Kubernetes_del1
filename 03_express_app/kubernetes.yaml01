apiVersion: apps/v1
kind: Deployment
metadata:
  name: learniken-express-app
spec:
  replicas: 4
  selector:
    matchLabels:
      app: express-app
  template:
    metadata:
      labels:
        app: express-app
    spec:
      containers:
      - name: express-app
        image: magneka/learniken-express-app:latest
        ports:
        - containerPort: 80
        env:
        - name: PORT
          value: "80"
---
apiVersion: v1
kind: Service
metadata:
  name: learniken-express-app-service
spec:
  type: LoadBalancer
  ports:
  - port: 8082
    targetPort: 80
  selector:
    app: express-app
